datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
}

enum CampaignStatus {
  active
  paused
  completed
  cancelled
}

model User {
  id               String            @id @default(uuid())
  googleId         String            @unique
  name             String
  email            String            @unique
  avatar           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  senders          Sender[]
  campaigns        EmailCampaign[]
  scheduledEmails  ScheduledEmail[]
  slackIntegration SlackIntegration?

  @@map("users")
}

model Sender {
  id               String            @id @default(uuid())
  userId           String
  email            String
  displayName      String
  smtpHost         String            @default("smtp.ethereal.email")
  smtpPort         Int               @default(587)
  smtpUser         String
  smtpPass         String            // Encrypted at rest
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEmails  ScheduledEmail[]
  rateLimitRecords RateLimitRecord[]

  @@unique([userId, email])
  @@map("senders")
}

model EmailCampaign {
  id                 String            @id @default(uuid())
  userId             String
  subject            String
  body               String
  startTime          DateTime          @default(now())
  delayBetweenEmails Int               @default(2000) // Delay in milliseconds between consecutive emails
  hourlyLimit        Int               @default(200)  // Max emails per hour for this campaign
  status             CampaignStatus    @default(active)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEmails    ScheduledEmail[]

  @@index([userId])
  @@map("email_campaigns")
}

model ScheduledEmail {
  id                 String            @id @default(uuid())
  campaignId         String
  userId             String
  senderId           String
  recipientEmail     String
  subject            String
  body               String
  scheduledAt        DateTime
  sentAt             DateTime?
  status             EmailStatus       @default(scheduled)
  bullJobId          String?
  idempotencyKey     String            @unique
  errorMessage       String?
  etherealPreviewUrl String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  campaign           EmailCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender             Sender            @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([status, scheduledAt])
  @@index([userId, status])
  @@index([senderId, scheduledAt])
  @@map("scheduled_emails")
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String   // Encrypted at rest
  teamId      String
  teamName    String
  channelId   String?
  connected   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slack_integrations")
}

model RateLimitRecord {
  id         String   @id @default(uuid())
  senderId   String
  hourWindow String   // Format: YYYYMMDDHH (e.g. 2026112016)
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender     Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, hourWindow])
  @@index([hourWindow])
  @@map("rate_limit_records")
}
